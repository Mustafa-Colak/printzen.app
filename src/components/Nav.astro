---
import { getAlternatePath, type Locale } from '../utils/i18n';
import SearchModal from './SearchModal.astro';

interface Props {
  lang: Locale;
  wide?: boolean;
  /** Override the auto-computed alternate-locale URL — needed when the two locales use different slugs. */
  alternatePath?: string;
}
const { lang, wide = false, alternatePath: alternatePathProp } = Astro.props;
const guidesPath = lang === 'tr' ? '/tr/rehberler' : '/guides';
const printersPath = lang === 'tr' ? '/tr/yazicilar' : '/printers';
const alternatePath = alternatePathProp ?? getAlternatePath(Astro.url.pathname, lang);
---
<nav class="bg-white/95 backdrop-blur-md border-b border-gray-100 sticky top-0 z-30 transition-all">
  <div class={`${wide ? 'max-w-6xl' : 'max-w-4xl'} mx-auto px-4 py-3 flex items-center justify-between gap-4`}>
    
    <!-- Logo & Slogan -->
    <div class="flex items-center gap-6 shrink-0">
      <a href={lang === 'tr' ? '/tr/' : '/'} class="flex items-center gap-2 group">
        <div class="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center text-white font-black text-lg shadow-xs group-hover:bg-blue-700 transition">
          P
        </div>
        <span class="text-xl font-bold text-gray-900 tracking-tight">Printzen</span>
      </a>

      <!-- Desktop Nav Links -->
      <div class="hidden md:flex items-center gap-5 text-sm font-medium text-gray-600">
        <a href={guidesPath} class="hover:text-blue-600 transition flex items-center gap-1.5">
          <span>📚</span>
          <span>{lang === 'tr' ? 'Rehberler & Kütüphane' : 'Guides & Hubs'}</span>
        </a>
        <a href={printersPath} class="hover:text-blue-600 transition flex items-center gap-1.5">
          <span>🖨️</span>
          <span>{lang === 'tr' ? 'Desteklenen Yazıcılar' : 'Printers'}</span>
        </a>
        <a href="#pricing" class="hover:text-blue-600 transition">
          {lang === 'tr' ? 'Fiyatlandırma' : 'Pricing'}
        </a>
      </div>
    </div>

    <!-- Search + Action Buttons -->
    <div class="flex items-center gap-3">
      <!-- Live Search Button & Modal -->
      <SearchModal lang={lang} />

      <!-- Language Toggle -->
      <a href={alternatePath} class="text-xs font-semibold text-gray-600 border border-gray-200 rounded-lg px-2.5 py-1.5 hover:bg-gray-50 transition" title="Change Language">
        {lang === 'tr' ? 'EN' : 'TR'}
      </a>

      <!-- Android App Primary CTA Button -->
      <a
        href="https://play.google.com/store/apps/details?id=com.mobileprint.service"
        target="_blank"
        rel="noopener"
        class="hidden sm:inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white text-xs md:text-sm font-semibold px-4 py-2 rounded-xl transition shadow-sm hover:shadow-md"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M3 20.5v-17c0-.83 1.01-1.3 1.66-.78l15 8.5a1 1 0 010 1.56l-15 8.5C4.01 21.8 3 21.33 3 20.5z"/></svg>
        <span>{lang === 'tr' ? 'Android App İndir' : 'Get Android App'}</span>
      </a>
    </div>
  </div>
</nav>
