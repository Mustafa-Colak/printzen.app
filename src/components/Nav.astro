---
import { getAlternatePath, type Locale } from '../utils/i18n';
import SearchModal from './SearchModal.astro';

interface Props {
  lang: Locale;
  wide?: boolean;
  /** Override the auto-computed alternate-locale URL — needed when the two locales use different slugs. */
  alternatePath?: string;
}
const { lang, wide = false, alternatePath: alternatePathProp } = Astro.props;
const guidesPath = lang === 'tr' ? '/tr/rehberler/' : '/guides/';
const printersPath = lang === 'tr' ? '/tr/yazicilar/' : '/printers/';
const alternatePath = alternatePathProp ?? getAlternatePath(Astro.url.pathname, lang);
---
<nav class="bg-paper/95 backdrop-blur-md border-b border-gray-200 sticky top-0 z-30 transition-all">
  <div class={`${wide ? 'max-w-6xl' : 'max-w-4xl'} mx-auto px-4 py-3 flex items-center justify-between gap-4`}>

    <!-- Logo & Slogan -->
    <div class="flex items-center gap-6 shrink-0">
      <a href={lang === 'tr' ? '/tr/' : '/'} class="flex items-center gap-2 group">
        <div class="w-8 h-8 rounded-md bg-ink flex items-center justify-center text-paper font-display font-bold text-lg group-hover:bg-accent-dark transition">
          P
        </div>
        <span class="text-xl font-display font-bold text-ink tracking-tight">Printzen</span>
        <span class="hidden lg:inline font-mono text-[10px] font-medium text-ink/40 uppercase tracking-wider border-l border-gray-300 pl-2 ml-1">
          {lang === 'tr' ? 'Yazdırma Otoritesi' : 'Printing Authority'}
        </span>
      </a>

      <!-- Desktop Nav Links -->
      <div class="hidden md:flex items-center gap-5 text-sm font-medium text-ink/70">
        <a href={guidesPath} class="hover:text-accent transition">
          {lang === 'tr' ? 'Rehberler & Kütüphane' : 'Guides & Hubs'}
        </a>
        <a href={printersPath} class="hover:text-accent transition">
          {lang === 'tr' ? 'Desteklenen Yazıcılar' : 'Supported Printers'}
        </a>
        <a href={`${lang === 'tr' ? '/tr/' : '/'}#android-app`} class="hover:text-accent transition">
          {lang === 'tr' ? 'Android Uygulaması' : 'Android App'}
        </a>
      </div>
    </div>

    <!-- Search + Action Buttons -->
    <div class="flex items-center gap-3">
      <!-- Live Search Button & Modal -->
      <SearchModal lang={lang} />

      <!-- Language Toggle -->
      <a href={alternatePath} class="font-mono text-xs font-medium text-ink/70 border border-gray-300 rounded-md px-2.5 py-1.5 hover:bg-gray-100 transition" title="Change Language">
        {lang === 'tr' ? 'EN' : 'TR'}
      </a>

      <!-- Primary CTA: content hub, not a single product -->
      <a
        href={guidesPath}
        class="hidden sm:inline-flex items-center gap-2 bg-ink hover:bg-accent-dark text-paper text-xs md:text-sm font-semibold px-4 py-2 rounded-md transition"
      >
        <span>{lang === 'tr' ? 'Rehberlere Göz At' : 'Browse Guides'}</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</nav>
