---
import type { Locale } from '../utils/i18n';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const prefix = lang === 'tr' ? '/tr' : '';
const guidesPath = lang === 'tr' ? '/tr/rehberler' : '/guides';
const printersPath = lang === 'tr' ? '/tr/yazicilar' : '/printers';
---
<footer class="bg-ink text-terminal-dim py-12 mt-8">
  <div class="max-w-5xl mx-auto px-4">
    <div class="flex flex-col md:flex-row justify-between gap-10 pb-10 border-b border-white/10">
      <div class="max-w-sm">
        <a href={lang === 'tr' ? '/tr/' : '/'} class="text-paper font-display font-bold text-xl">Printzen</a>
        <p class="font-mono text-xs font-medium text-terminal-amber uppercase tracking-wider mt-2">
          {lang === 'tr' ? 'Termal Yazdırmanın Otoritesi' : 'The Thermal Printing Authority'}
        </p>
        <p class="text-sm mt-3 leading-relaxed">
          {lang === 'tr'
            ? 'Termal fiş ve etiket yazdırmanın tanımlayıcı referansı: protokol belgeleri, donanım karar desteği ve entegrasyon rehberleri — geliştiriciler, e-ticaret satıcıları ve SaaS sağlayıcıları için.'
            : 'The definitive reference for thermal receipt & label printing: protocol documentation, hardware decision support, and integration guides — built for developers, e-commerce sellers, and SaaS providers.'}
        </p>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-8 text-sm">
        <div class="flex flex-col gap-2">
          <span class="text-paper font-semibold mb-1">{lang === 'tr' ? 'İçerik' : 'Content'}</span>
          <a href={guidesPath} class="hover:text-paper transition">{lang === 'tr' ? 'Rehberler' : 'Guides'}</a>
        </div>
        <div class="flex flex-col gap-2">
          <span class="text-paper font-semibold mb-1">{lang === 'tr' ? 'Ürünler' : 'Products'}</span>
          <a href={`${lang === 'tr' ? '/tr/' : '/'}#android-app`} class="hover:text-paper transition">{lang === 'tr' ? 'Android Uygulaması' : 'Android App'}</a>
          <a href={printersPath} class="hover:text-paper transition">{lang === 'tr' ? 'Desteklenen Yazıcılar' : 'Supported Printers'}</a>
        </div>
        <div class="flex flex-col gap-2">
          <span class="text-paper font-semibold mb-1">{lang === 'tr' ? 'Yasal' : 'Legal'}</span>
          <a href={`${prefix}/terms/`} class="hover:text-paper transition">{lang === 'tr' ? 'Kullanım Şartları' : 'Terms of Service'}</a>
          <a href={`${prefix}/privacy/`} class="hover:text-paper transition">{lang === 'tr' ? 'Gizlilik Politikası' : 'Privacy Policy'}</a>
          <a href={`${prefix}/refund/`} class="hover:text-paper transition">{lang === 'tr' ? 'İade Politikası' : 'Refund Policy'}</a>
        </div>
      </div>
    </div>
    <div class="flex flex-col md:flex-row justify-between items-center gap-4 pt-6 text-sm">
      <div class="font-mono text-xs">© 2026 Printzen</div>
      <a href="mailto:support@printzen.app" class="hover:text-paper transition">support@printzen.app</a>
    </div>
  </div>
</footer>
