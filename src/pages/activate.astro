---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Printzen — Lisansı Aktive Et" lang="tr" noindex={true}>
  <div class="min-h-screen flex items-center justify-center bg-paper">
    <div class="text-center px-4 max-w-md">
      <h1 class="font-display text-2xl font-bold text-ink mb-2">Lisansı Aktive Et</h1>
      <p class="text-ink/60 mb-6">Aşağıdaki butona basarak Mobile Print Service uygulamasında lisansınızı aktive edin.</p>
      <div class="bg-gray-100 rounded-md px-4 py-3 mb-6 font-mono text-lg tracking-widest text-ink" id="keyDisplay"></div>
      <button id="openBtn"
        class="bg-ink text-paper px-8 py-4 rounded-md text-lg font-semibold hover:bg-accent-dark transition w-full">
        Uygulamada Aç &amp; Aktive Et
      </button>
      <p class="text-sm text-ink/40 mt-6">Uygulama yüklü değilse <a href="/MobilePrintService.apk" class="text-accent hover:underline">önce indirin</a>.</p>
      <p class="mt-4"><a href="/tr/" class="text-accent hover:underline text-sm">← printzen.app</a></p>
    </div>
  </div>

  <script>
    function getKey() {
      return new URLSearchParams(window.location.search).get('key') || '';
    }
    function openInApp() {
      const key = getKey();
      window.location.href = 'mps://activate?key=' + encodeURIComponent(key);
    }
    window.onload = function () {
      const key = getKey();
      if (key) {
        document.getElementById('keyDisplay').textContent = key;
        document.getElementById('openBtn').onclick = openInApp;
        if (/android/i.test(navigator.userAgent)) {
          setTimeout(openInApp, 500);
        }
      }
    };
  </script>
</BaseLayout>
