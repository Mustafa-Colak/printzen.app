---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const allGuides = await getCollection('guides', (entry) => entry.slug.startsWith('en/'));
const recentGuides = [...allGuides]
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);
const printers = await getCollection('printers');

const PILLARS = [
  {
    icon: '💻',
    title: 'Developer Guides',
    description: 'Web Bluetooth, WebUSB, raw TCP sockets, and REST API patterns for connecting web and mobile apps directly to thermal printers — with working code.',
    href: '/guides',
  },
  {
    icon: '🔧',
    title: 'Hardware & Protocol Decision Support',
    description: 'ESC/POS, ZPL, TSPL, and CPCL command references, code page tables, and class-by-class guidance for choosing mobile, desktop, or industrial hardware.',
    href: '/guides',
  },
  {
    icon: '🛠️',
    title: 'Troubleshooting & Operations',
    description: 'Fixes for Bluetooth pairing failures, faded print, label calibration, shipping-label sizing, and silent/kiosk printing issues.',
    href: '/guides',
  },
];
---
<BaseLayout
  lang="en"
  title="Printzen — The Thermal Printing Authority"
  description="The definitive reference for thermal receipt & label printing: protocol documentation, hardware decision guides, and integration walkthroughs for ESC/POS, ZPL, TSPL and more — plus an Android print app with its own supported-printer list."
>
  <Nav wide lang="en" />

  <!-- Hero -->
  <section class="max-w-5xl mx-auto px-4 py-20">
    <div class="grid md:grid-cols-5 gap-12 items-center">
      <div class="md:col-span-3">
        <div class="inline-block bg-blue-50 text-blue-700 text-sm font-medium px-4 py-1 rounded-full mb-6">
          The Thermal Printing Authority
        </div>
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6 leading-tight">
          The definitive reference for<br>thermal receipt &amp; label printing
        </h1>
        <p class="text-xl text-gray-500 mb-10">
          Protocol references, hardware decision guides, and integration walkthroughs for ESC/POS, ZPL, TSPL, and CPCL — built for developers, e-commerce sellers, restaurant operators, and SaaS providers connecting apps to thermal printers.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/guides"
             class="bg-blue-600 text-white px-8 py-4 rounded-xl text-lg font-semibold hover:bg-blue-700 transition inline-flex items-center gap-2 shadow-lg">
            Browse Guides →
          </a>
          <a href="/printers" class="bg-white text-blue-600 border border-blue-200 px-8 py-4 rounded-xl text-lg font-semibold hover:bg-blue-50 transition inline-block shadow">
            Check Supported Printers →
          </a>
        </div>
        <p class="text-sm text-gray-400 mt-4">
          {allGuides.length}+ technical guides · {printers.length} printer models tested with the Android app
        </p>
      </div>

      <div class="md:col-span-2 bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="font-bold text-gray-900">Recent guides</h2>
          <a href="/guides/" class="text-sm text-blue-600 hover:underline shrink-0">View all →</a>
        </div>
        <div class="divide-y divide-gray-100">
          {recentGuides.map((guide) => (
            <a href={`/guides/${guide.slug.replace(/^en\//, '')}/`} class="flex items-center gap-3 py-3 group">
              <div class="text-blue-600 shrink-0">📄</div>
              <div>
                <p class="text-sm font-medium text-gray-900 group-hover:text-blue-600 transition">{guide.data.title}</p>
              </div>
            </a>
          ))}
        </div>
        <a href="/printers/" class="block mt-4 pt-4 border-t border-gray-100 text-sm text-blue-600 hover:underline">
          See printers supported by the Android app →
        </a>
      </div>
    </div>
  </section>

  <!-- Three Pillars -->
  <section class="max-w-5xl mx-auto px-4 py-12">
    <div class="mb-10">
      <span class="text-xs font-bold text-blue-600 uppercase tracking-wider">What's here</span>
      <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mt-1">Three pillars, one platform</h2>
    </div>
    <div class="grid md:grid-cols-3 gap-6">
      {PILLARS.map((pillar) => (
        <a href={pillar.href} class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 hover:border-blue-300 hover:shadow-md transition block group">
          <div class="text-3xl mb-3">{pillar.icon}</div>
          <h3 class="font-bold text-lg mb-2 group-hover:text-blue-600 transition">{pillar.title}</h3>
          <p class="text-gray-500 text-sm leading-relaxed">{pillar.description}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Android App (one product among the offering, not the whole identity) -->
  <section id="android-app" class="max-w-5xl mx-auto px-4 py-20 scroll-mt-20">
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-8 md:p-12">
      <div class="grid md:grid-cols-5 gap-10 items-center">
        <div class="md:col-span-3">
          <div class="inline-flex items-center gap-2 bg-blue-50 text-blue-700 text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider mb-4">
            <span>📱</span> Also from Printzen
          </div>
          <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4">Mobile Print Service for Android</h2>
          <p class="text-gray-500 mb-6 leading-relaxed">
            Print from any Android app to any thermal printer through the system print dialog — Bluetooth, Wi-Fi, or USB. Supports Zebra, Honeywell, TSC, Seiko, Bixolon, Sewoo, Rongta, and any generic ESC/POS thermal printer.
          </p>
          <a href="https://play.google.com/store/apps/details?id=com.mobileprint.service" target="_blank" rel="noopener"
             class="bg-blue-600 text-white px-6 py-3 rounded-xl text-sm font-semibold hover:bg-blue-700 transition inline-flex items-center gap-2 shadow">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M3 20.5v-17c0-.83 1.01-1.3 1.66-.78l15 8.5a1 1 0 010 1.56l-15 8.5C4.01 21.8 3 21.33 3 20.5z"/></svg>
            Get on Google Play
          </a>
        </div>
        <div class="md:col-span-2 grid grid-cols-2 gap-4">
          <div class="border border-gray-200 rounded-xl p-4">
            <p class="text-xs font-semibold text-gray-400 uppercase mb-1">BT Plan</p>
            <p class="text-2xl font-bold text-gray-900 mb-1">$9.90</p>
            <p class="text-xs text-gray-400">one-time · Bluetooth + USB</p>
          </div>
          <div class="border border-blue-200 bg-blue-50 rounded-xl p-4">
            <p class="text-xs font-semibold text-blue-600 uppercase mb-1">Full Plan</p>
            <p class="text-2xl font-bold text-gray-900 mb-1">$14.90</p>
            <p class="text-xs text-gray-500">one-time · + Wi-Fi &amp; HTTP API</p>
          </div>
        </div>
      </div>
      <p class="text-xs text-gray-400 mt-6 pt-6 border-t border-gray-100">
        Both plans include a 30-day free trial and free updates, no subscription.
      </p>
    </div>
  </section>

  <Footer lang="en" />
</BaseLayout>
