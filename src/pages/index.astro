---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const allGuides = await getCollection('guides', (entry) => entry.slug.startsWith('en/'));
const recentGuides = [...allGuides]
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);
const printers = await getCollection('printers');

const PILLARS = [
  {
    tag: '01',
    title: 'Developer Guides',
    description: 'Web Bluetooth, WebUSB, raw TCP sockets, and REST API patterns for connecting web and mobile apps directly to thermal printers — with working code.',
    href: '/guides/',
  },
  {
    tag: '02',
    title: 'Hardware & Protocol Decision Support',
    description: 'ESC/POS, ZPL, TSPL, and CPCL command references, code page tables, and class-by-class guidance for choosing mobile, desktop, or industrial hardware.',
    href: '/guides/',
  },
  {
    tag: '03',
    title: 'Troubleshooting & Operations',
    description: 'Fixes for Bluetooth pairing failures, faded print, label calibration, shipping-label sizing, and silent/kiosk printing issues.',
    href: '/guides/',
  },
];
---
<BaseLayout
  lang="en"
  title="Printzen — The Thermal Printing Authority"
  description="The definitive reference for thermal receipt & label printing: protocol documentation, hardware decision guides, and integration walkthroughs for ESC/POS, ZPL, TSPL and more — plus an Android print app with its own supported-printer list."
>
  <Nav wide lang="en" />

  <!-- Hero -->
  <section class="max-w-5xl mx-auto px-4 py-20">
    <div class="flex flex-col md:flex-row gap-12 items-start">
      <div class="flex-1 min-w-0">
        <div class="font-mono text-xs font-medium tracking-wider uppercase text-accent mb-6">
          The Thermal Printing Authority
        </div>
        <h1 class="font-display text-4xl md:text-5xl font-bold text-ink mb-6 leading-tight tracking-tight">
          The definitive reference for<br>thermal receipt &amp; label printing
        </h1>
        <p class="text-lg text-ink/60 mb-10 max-w-xl">
          Protocol references, hardware decision guides, and integration walkthroughs for ESC/POS, ZPL, TSPL, and CPCL — built for developers, e-commerce sellers, restaurant operators, and SaaS providers connecting apps to thermal printers.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/guides/"
             class="bg-ink text-paper px-7 py-3.5 rounded-md text-base font-semibold hover:bg-accent-dark transition inline-flex items-center gap-2">
            Browse Guides →
          </a>
          <a href="/printers/" class="bg-transparent text-ink border border-gray-300 px-7 py-3.5 rounded-md text-base font-semibold hover:border-accent hover:text-accent transition inline-block">
            Check Supported Printers
          </a>
        </div>
        <p class="font-mono text-xs text-ink/40 mt-5">
          {allGuides.length}+ technical guides · {printers.length} printer models tested with the Android app
        </p>
      </div>

      <div class="w-full md:w-[320px] shrink-0 bg-terminal rounded-md overflow-hidden shadow-xl shadow-ink/10">
        <div class="flex items-center gap-1.5 px-3.5 py-2.5 bg-terminal-head border-b border-terminal-border">
          <div class="w-2 h-2 rounded-full bg-terminal-mid"></div>
          <div class="w-2 h-2 rounded-full bg-terminal-mid"></div>
          <div class="w-2 h-2 rounded-full bg-terminal-mid"></div>
          <span class="ml-1.5 font-mono text-[11px] text-terminal-dim">escpos-print.log</span>
        </div>
        <div class="p-4.5 font-mono text-[12.5px] leading-[1.8]">
          <div class="text-terminal-mid">; cut + bold header</div>
          <div class="text-terminal-text"><span class="text-terminal-amber">GS</span> V 66 0</div>
          <div class="text-terminal-text"><span class="text-terminal-amber">ESC</span> ! 0x08</div>
          <div class="text-terminal-text">"ORDER #4821"</div>
          <div class="text-terminal-text"><span class="text-terminal-amber">ESC</span> ! 0x00</div>
          <div class="text-terminal-mid">--------------------------------</div>
          <div class="text-terminal-dim">2x Americano&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;85.00</div>
          <div class="text-terminal-dim">1x Cheesecake&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;120.00</div>
          <div class="text-terminal-mid">--------------------------------</div>
          <div class="text-terminal-text font-semibold">TOTAL&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;205.00</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Recent guides strip -->
  <section class="max-w-5xl mx-auto px-4 pb-12">
    <div class="flex items-center justify-between mb-4 border-t border-gray-200 pt-8">
      <span class="font-mono text-xs font-medium tracking-wider uppercase text-ink/40">Recent guides</span>
      <a href="/guides/" class="text-sm text-accent hover:underline shrink-0">View all →</a>
    </div>
    <div class="grid md:grid-cols-3 gap-4">
      {recentGuides.map((guide) => (
        <a href={`/guides/${guide.slug.replace(/^en\//, '')}/`} class="border border-gray-200 rounded-md p-4 hover:border-accent/40 transition group">
          <p class="text-sm font-medium text-ink group-hover:text-accent transition leading-snug">{guide.data.title}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Three Pillars -->
  <section class="max-w-5xl mx-auto px-4 py-12">
    <div class="mb-10">
      <span class="font-mono text-xs font-medium tracking-wider uppercase text-accent">What's here</span>
      <h2 class="font-display text-2xl md:text-3xl font-bold text-ink mt-1">Three pillars, one platform</h2>
    </div>
    <div class="grid md:grid-cols-3 gap-6">
      {PILLARS.map((pillar) => (
        <a href={pillar.href} class="bg-paper rounded-md p-6 border border-gray-200 hover:border-accent/50 transition block group">
          <div class="font-mono text-xs text-ink/30 mb-3">{pillar.tag}</div>
          <h3 class="font-display font-semibold text-lg mb-2 text-ink group-hover:text-accent transition">{pillar.title}</h3>
          <p class="text-ink/60 text-sm leading-relaxed">{pillar.description}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Android App (one product among the offering, not the whole identity) -->
  <section id="android-app" class="max-w-5xl mx-auto px-4 py-20 scroll-mt-20">
    <div class="bg-paper rounded-md border border-gray-200 p-8 md:p-12">
      <div class="grid md:grid-cols-5 gap-10 items-center">
        <div class="md:col-span-3">
          <div class="font-mono text-xs font-medium tracking-wider uppercase text-accent mb-4">
            Also from Printzen
          </div>
          <h2 class="font-display text-2xl md:text-3xl font-bold text-ink mb-4">Mobile Print Service for Android</h2>
          <p class="text-ink/60 mb-6 leading-relaxed">
            Print from any Android app to any thermal printer through the system print dialog — Bluetooth, Wi-Fi, or USB. Supports Zebra, Honeywell, TSC, Seiko, Bixolon, Sewoo, Rongta, and any generic ESC/POS thermal printer.
          </p>
          <a href="https://play.google.com/store/apps/details?id=com.mobileprint.service" target="_blank" rel="noopener"
             class="bg-ink text-paper px-6 py-3 rounded-md text-sm font-semibold hover:bg-accent-dark transition inline-flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M3 20.5v-17c0-.83 1.01-1.3 1.66-.78l15 8.5a1 1 0 010 1.56l-15 8.5C4.01 21.8 3 21.33 3 20.5z"/></svg>
            Get on Google Play
          </a>
        </div>
        <div class="md:col-span-2 grid grid-cols-2 gap-4">
          <div class="border border-gray-200 rounded-md p-4">
            <p class="font-mono text-xs text-ink/40 uppercase mb-1">BT Plan</p>
            <p class="text-2xl font-display font-bold text-ink mb-1">$9.90</p>
            <p class="text-xs text-ink/40">one-time · Bluetooth + USB</p>
          </div>
          <div class="border border-accent/30 bg-accent/5 rounded-md p-4">
            <p class="font-mono text-xs text-accent uppercase mb-1">Full Plan</p>
            <p class="text-2xl font-display font-bold text-ink mb-1">$14.90</p>
            <p class="text-xs text-ink/50">one-time · + Wi-Fi &amp; HTTP API</p>
          </div>
        </div>
      </div>
      <p class="text-xs text-ink/40 mt-6 pt-6 border-t border-gray-200">
        Both plans include a 30-day free trial and free updates, no subscription.
      </p>
    </div>
  </section>

  <Footer lang="en" />
</BaseLayout>
