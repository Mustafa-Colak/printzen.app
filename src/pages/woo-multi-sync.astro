<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WooCommerce Multi-Store Sync PRO | Printzen Apps</title>
    <link rel="canonical" href="https://printzen.app/woo-multi-sync/">
    
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">
    
    <!-- Paddle.js Billing v2 -->
    <script is:inline src="https://cdn.paddle.com/paddle/v2/paddle.js"></script>

    <style>
        :root {
            --bg-color: #0b0f19;
            --bg-surface: #131a2b;
            --text-main: #ffffff;
            --text-muted: #8b949e;
            --accent-gradient: linear-gradient(135deg, #4f46e5 0%, #a855f7 100%);
            --glass-bg: rgba(255, 255, 255, 0.03);
            --glass-border: rgba(255, 255, 255, 0.08);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-main);
            overflow-x: hidden;
            line-height: 1.6;
        }

        /* Ambient Glow Backgrounds */
        .glow-circle {
            position: absolute;
            width: 600px;
            height: 600px;
            background: var(--accent-gradient);
            filter: blur(150px);
            opacity: 0.15;
            border-radius: 50%;
            z-index: -1;
        }
        .glow-top-left { top: -200px; left: -200px; }
        .glow-bottom-right { bottom: 20%; right: -200px; }

        /* Navigation */
        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 2rem 5%;
            max-width: 1200px;
            margin: 0 auto;
        }
        
        .logo {
            font-size: 1.5rem; font-weight: 800; letter-spacing: -0.5px;
            display: flex; align-items: center; gap: 10px;
        }

        .nav-links a { color: var(--text-muted); text-decoration: none; font-weight: 600; transition: color 0.3s ease; }
        .nav-links a:hover { color: var(--text-main); }

        /* Hero Section */
        .hero { text-align: center; padding: 6rem 20px 4rem; max-width: 1000px; margin: 0 auto; }
        .pill {
            display: inline-block; background: rgba(168, 85, 247, 0.1); color: #d8b4fe;
            padding: 6px 16px; border-radius: 50px; font-size: 0.85rem; font-weight: 600;
            margin-bottom: 2rem; border: 1px solid rgba(168, 85, 247, 0.2);
        }
        .hero h1 { font-size: 4.5rem; font-weight: 800; line-height: 1.1; letter-spacing: -1.5px; margin-bottom: 1.5rem; }
        .hero h1 span { background: var(--accent-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .hero p { font-size: 1.25rem; color: var(--text-muted); margin-bottom: 3rem; max-width: 700px; margin-inline: auto; }

        /* Button */
        .btn-primary {
            display: inline-block; background: var(--accent-gradient); color: white;
            text-decoration: none; padding: 18px 40px; border-radius: 8px; font-size: 1.1rem;
            font-weight: 600; transition: transform 0.2s ease, box-shadow 0.2s ease; cursor: pointer; border: none;
        }
        .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 10px 25px rgba(168, 85, 247, 0.4); }
        .price-note { display: block; margin-top: 15px; font-size: 0.9rem; color: var(--text-muted); }

        /* Hero Mockup Image */
        .hero-mockup {
            margin-top: 5rem;
            position: relative;
            border-radius: 16px;
            padding: 10px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5), 0 0 150px rgba(168, 85, 247, 0.15);
            backdrop-filter: blur(10px);
            transform: perspective(1200px) rotateX(4deg);
            transition: transform 0.5s ease, box-shadow 0.5s ease;
        }
        .hero-mockup:hover {
            transform: perspective(1200px) rotateX(0deg) scale(1.02);
            box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.6), 0 0 200px rgba(168, 85, 247, 0.25);
        }
        .hero-mockup img {
            width: 100%;
            height: auto;
            border-radius: 8px;
            display: block;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        /* Sections */
        section.content-section { padding: 5rem 20px; max-width: 1200px; margin: 0 auto; }
        .section-title { text-align: center; font-size: 2.5rem; font-weight: 800; margin-bottom: 3rem; }

        /* Features Glass Grid */
        .features { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; }
        .feature-card {
            background: var(--glass-bg); border: 1px solid var(--glass-border);
            border-radius: 16px; padding: 2.5rem; backdrop-filter: blur(10px); transition: transform 0.3s ease;
        }
        .feature-card:hover { transform: translateY(-5px); border-color: rgba(168, 85, 247, 0.3); }
        .feature-icon { font-size: 2.5rem; margin-bottom: 1.5rem; }
        .feature-card h3 { font-size: 1.25rem; margin-bottom: 1rem; font-weight: 600; }
        .feature-card p { color: var(--text-muted); font-size: 0.95rem; }

        /* How it Works */
        .steps { display: flex; flex-direction: column; gap: 2rem; max-width: 800px; margin: 0 auto; }
        .step { display: flex; gap: 1.5rem; background: var(--bg-surface); padding: 2rem; border-radius: 12px; border: 1px solid var(--glass-border); }
        .step-num { 
            background: var(--accent-gradient); color: white; font-weight: bold; font-size: 1.5rem;
            width: 50px; height: 50px; display: flex; align-items: center; justify-content: center; border-radius: 50%; flex-shrink: 0;
        }
        .step-content h3 { font-size: 1.3rem; margin-bottom: 0.5rem; }
        .step-content p { color: var(--text-muted); }

        /* FAQ */
        .faq-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 2rem; }
        .faq-item h4 { font-size: 1.1rem; margin-bottom: 0.5rem; color: #e2e8f0; }
        .faq-item p { color: var(--text-muted); font-size: 0.95rem; }

        /* CTA Footer */
        .cta-bottom { text-align: center; padding: 6rem 20px; background: var(--bg-surface); border-top: 1px solid var(--glass-border); margin-top: 4rem; }
        .trust-badges { display: flex; justify-content: center; gap: 2rem; margin-top: 2rem; color: var(--text-muted); font-size: 0.9rem; align-items: center;}

        /* Responsive */
        @media (max-width: 768px) {
            .hero h1 { font-size: 3rem; }
            .hero p { font-size: 1.1rem; }
            .step { flex-direction: column; }
            .trust-badges { flex-direction: column; gap: 1rem; }
        }

        /* Loading Overlay */
        .loader-overlay {
            position: fixed; top: 0; left: 0; right: 0; bottom: 0;
            background: var(--bg-color); z-index: 9999;
            display: none; flex-direction: column; align-items: center; justify-content: center;
            transition: opacity 0.3s ease;
        }
        .loader-spinner {
            width: 50px; height: 50px; border: 4px solid rgba(168, 85, 247, 0.2);
            border-top-color: #a855f7; border-radius: 50%; animation: spin 1s linear infinite; margin-bottom: 20px;
        }
        @keyframes spin { 100% { transform: rotate(360deg); } }
        .loader-text { font-size: 1.25rem; font-weight: 600; color: var(--text-main); }
    </style>
</head>
<body>

    <!-- Loading Overlay -->
    <div id="checkout-loader" class="loader-overlay">
        <div class="loader-spinner"></div>
        <div class="loader-text">Güvenli ödeme sayfasına yönlendiriliyorsunuz, lütfen bekleyin...</div>
    </div>

    <div class="glow-circle glow-top-left"></div>
    <div class="glow-circle glow-bottom-right"></div>

    <nav>
        <div class="logo">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2L2 7L12 12L22 7L12 2Z" fill="url(#paint0_linear)"/>
                <path d="M2 17L12 22L22 17M2 12L12 17L22 12" stroke="url(#paint0_linear)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <defs>
                    <linearGradient id="paint0_linear" x1="2" y1="2" x2="22" y2="22" gradientUnits="userSpaceOnUse">
                        <stop stop-color="#4F46E5"/><stop offset="1" stop-color="#A855F7"/>
                    </linearGradient>
                </defs>
            </svg>
            Printzen Apps
        </div>
        <div class="nav-links">
            <a href="#" onclick="openPaddleCheckout(event)">Get PRO</a>
        </div>
    </nav>

    <section class="hero">
        <div class="pill">✨ Version 1.0 is Live</div>
        <h1>Unify Your <br><span>WooCommerce Empire</span></h1>
        <p>Seamlessly synchronize products, stock, and pricing across unlimited WordPress stores. Build a centralized network powered by lightning-fast APIs.</p>
        
        <a href="#!" class="btn-primary" onclick="openPaddleCheckout(event)">
            Get PRO License - $99
        </a>
        <span class="price-note">One-time payment. Lifetime updates.</span>

        <div class="hero-mockup">
            <img src="/woo-sync-dashboard.png" alt="WooCommerce Multi-Store Synchronization Dashboard UI Mockup">
        </div>
    </section>

    <!-- Features -->
    <section class="content-section">
        <div class="features">
            <div class="feature-card">
                <div class="feature-icon">⚡️</div>
                <h3>Real-Time Synchronization</h3>
                <p>Any product updated on your primary store is instantly pushed to your secondary stores. Never worry about out-of-sync inventory again.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">🌐</div>
                <h3>Universal API Import</h3>
                <p>Import thousands of products from ANY supplier using our advanced XML and JSON importer. Easily map fields and map custom tax rates.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">📈</div>
                <h3>Bulk Price Engine</h3>
                <p>Apply flat percentage markups to hundreds of products at once. Instantly sync your updated profit margins across your entire network.</p>
            </div>
        </div>
    </section>

    <!-- How It Works -->
    <section class="content-section">
        <h2 class="section-title">How it works</h2>
        <div class="steps">
            <div class="step">
                <div class="step-num">1</div>
                <div class="step-content">
                    <h3>Install on your WordPress Network</h3>
                    <p>Upload and activate the Woo Multi-Sync plugin on your primary (main) store and any secondary (child) stores you want to connect.</p>
                </div>
            </div>
            <div class="step">
                <div class="step-num">2</div>
                <div class="step-content">
                    <h3>Connect the APIs</h3>
                    <p>Generate your secure WooCommerce API keys and paste them into the plugin settings. No complex coding required.</p>
                </div>
            </div>
            <div class="step">
                <div class="step-num">3</div>
                <div class="step-content">
                    <h3>Automate Everything</h3>
                    <p>Watch as product titles, descriptions, prices, and stock levels are instantly replicated across your entire e-commerce empire.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ -->
    <section class="content-section">
        <h2 class="section-title">Frequently Asked Questions</h2>
        <div class="faq-grid">
            <div class="faq-item">
                <h4>Is this a recurring subscription?</h4>
                <p>No, this is a one-time payment for a Lifetime License. You get all future updates and features forever without paying again.</p>
            </div>
            <div class="faq-item">
                <h4>How many secondary stores can I connect?</h4>
                <p>There is absolutely no limit. You can push products from one primary store to as many secondary WooCommerce stores as your server can handle.</p>
            </div>
            <div class="faq-item">
                <h4>Does it support custom metadata?</h4>
                <p>Yes, the plugin seamlessly maps standard WooCommerce fields as well as variable products, XML/JSON custom endpoints, and custom tax classes.</p>
            </div>
            <div class="faq-item">
                <h4>What if I need a refund?</h4>
                <p>We offer a strict 30-day money-back guarantee. If the plugin doesn't fit your workflow, just contact our support for a full refund.</p>
            </div>
        </div>
    </section>

    <!-- Bottom CTA -->
    <section class="cta-bottom">
        <h2 class="section-title">Ready to scale your stores?</h2>
        <a href="#!" class="btn-primary" onclick="openPaddleCheckout(event)">
            Get PRO License Now
        </a>
        <div class="trust-badges">
            <span>🔒 Secure Checkout via Paddle</span>
            <span>🛡️ 30-Day Money-Back Guarantee</span>
            <span>⚡️ Instant License Delivery</span>
        </div>
    </section>

    <!-- Initialize Paddle.js -->
    <script is:inline type="text/javascript">
        // Initialize Paddle
        Paddle.Initialize({ 
            token: 'live_a232701421a84ae13568067ed6e',
            eventCallback: function(data) {
                // Hide loader when checkout is fully loaded or closed
                if (data.name === 'checkout.loaded' || data.name === 'checkout.closed') {
                    const loader = document.getElementById('checkout-loader');
                    if (loader) {
                        loader.style.display = 'none';
                        if (loader.dataset.fallbackId) clearTimeout(Number(loader.dataset.fallbackId));
                    }
                }
            }
        });

        // Manual Trigger
        function openPaddleCheckout(e) {
            e.preventDefault();
            const loader = document.getElementById('checkout-loader');
            loader.style.display = 'flex';
            // Safety net: if Paddle's checkout never loads (e.g. blocked by an ad blocker),
            // don't leave the visitor stuck behind the loader forever.
            const fallback = setTimeout(function() {
                loader.style.display = 'none';
            }, 8000);
            loader.dataset.fallbackId = fallback;
            Paddle.Checkout.open({
                items: [
                    { priceId: 'pri_01kxam6hw34zadjy8w111076sc', quantity: 1 }
                ]
            });
        }
    </script>
</body>
</html>
