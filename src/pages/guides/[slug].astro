---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const guides = await getCollection('guides', (entry) => entry.slug.startsWith('en/'));
  return guides.map((guide) => ({
    params: { slug: guide.slug.replace(/^en\//, '') },
    props: { guide },
  }));
}

interface Props {
  guide: CollectionEntry<'guides'>;
}

const { guide } = Astro.props;
const { Content } = await guide.render();

const trGuide = (await getCollection('guides', (entry) => entry.slug.startsWith('tr/')))
  .find((entry) => entry.data.translationKey === guide.data.translationKey);
const alternatePath = trGuide ? `/tr/rehberler/${trGuide.slug.replace(/^tr\//, '')}/` : null;

const classLabels: Record<string, string> = {
  mobile: 'Mobile',
  desktop: 'Desktop',
  industrial: 'Industrial',
};

const imgMatch = guide.body.match(/src=["'](\/images\/[^"']+)["']/) || guide.body.match(/!\[[^\]]*\]\((\/images\/[^)]+)\)/);
const firstImageUrl = imgMatch ? `https://printzen.app${imgMatch[1]}` : undefined;

const faqEntities: Array<{ '@type': string; name: string; acceptedAnswer: { '@type': string; text: string } }> = [];
const faqSectionMatch = guide.body.match(/##\s+[^\n]*(?:Frequently\s+Asked\s+Questions)[^\n]*\n([\s\S]*?)(?=\n##\s+|\n---\s*\n|$)/i);
if (faqSectionMatch) {
  const qBlocks = faqSectionMatch[1].split(/\n###\s+/).filter((b) => b.trim());
  for (const block of qBlocks) {
    const cleanedBlock = block.replace(/^###\s+/, '');
    const nlIdx = cleanedBlock.indexOf('\n');
    if (nlIdx !== -1) {
      const q = cleanedBlock.slice(0, nlIdx).trim();
      const a = cleanedBlock.slice(nlIdx + 1).replace(/[*_`#>\[\]]/g, '').replace(/\s+/g, ' ').trim();
      if (q && a) {
        faqEntities.push({
          '@type': 'Question',
          name: q,
          acceptedAnswer: { '@type': 'Answer', text: a },
        });
      }
    }
  }
}

const articleSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: guide.data.title,
      description: guide.data.description,
      ...(firstImageUrl ? { image: firstImageUrl } : {}),
      datePublished: guide.data.publishDate.toISOString(),
      author: { '@type': 'Organization', name: 'Printzen' },
    },
    ...(faqEntities.length > 0
      ? [
          {
            '@type': 'FAQPage',
            mainEntity: faqEntities,
          },
        ]
      : []),
  ],
};
---
<BaseLayout lang="en" title={`${guide.data.title} — Printzen`} description={guide.data.description} alternatePath={alternatePath}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <Nav lang="en" alternatePath={alternatePath} />

  <main class="max-w-3xl mx-auto px-4 py-16">
    <a href="/guides/" class="text-sm text-accent hover:underline">← All guides</a>
    <span class="block font-mono text-xs font-medium text-accent uppercase tracking-wider mt-4 mb-3">
      {classLabels[guide.data.printerClass]}{guide.data.brand ? ` · ${guide.data.brand}` : ''}
    </span>
    <h1 class="font-display text-3xl font-bold text-ink mb-6">{guide.data.title}</h1>
    <article class="prose max-w-none prose-headings:font-display prose-a:text-accent prose-code:font-mono">
      <Content />
    </article>
  </main>

  <Footer lang="en" />
</BaseLayout>
