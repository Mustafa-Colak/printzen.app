---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';

const guides = (await getCollection('guides', (entry) => entry.slug.startsWith('tr/'))).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const classLabels: Record<string, string> = {
  mobile: 'Mobil',
  desktop: 'Masaüstü',
  industrial: 'Endüstriyel',
};

// Popüler Donanım Markaları ve pSEO Hızlı Erişim Kataloğu
const HARDWARE_SHOWCASE = [
  { brand: 'Epson', models: ['TM-T20III', 'TM-T88VI', 'TM-T88VII', 'TM-m30II', 'TM-P20II', 'TM-P80II'] },
  { brand: 'Zebra', models: ['ZD220', 'ZD420', 'ZD421', 'GK420d', 'ZT411', 'ZQ320 Plus'] },
  { brand: 'Xprinter', models: ['XP-420B', 'XP-365B', 'XP-470B', 'XP-N160II', 'XP-58IIH'] },
  { brand: 'Bixolon', models: ['SRP-330II', 'SRP-350III', 'SRP-Q300', 'SPP-R200III', 'SLP-TX400'] },
  { brand: 'Star Micronics', models: ['TSP143III', 'TSP654II', 'mC-Print3', 'SM-L200'] },
  { brand: 'TSC', models: ['TE200', 'TTP-244 Pro', 'DA210', 'DA220', 'Alpha-3R'] },
  { brand: 'Godex', models: ['G500', 'RT700', 'DT4x'] },
  { brand: 'Rongta', models: ['RPP02N', 'RP326', 'RP410', 'RP80'] },
];
---
<BaseLayout lang="tr" title="Termal Yazıcı Rehberleri & Bilgi Bankası — Printzen" description={`ESC/POS, ZPL, Bluetooth, USB ve ağ yazıcıları için ${guides.length} kapsamlı teknik geliştirici ve entegrasyon rehberi.`} alternatePath="/guides/">
  <Nav wide lang="tr" alternatePath="/guides/" />

  <!-- Hero Header -->
  <header class="bg-paper py-12 border-b border-gray-200">
    <div class="max-w-6xl mx-auto px-4">

      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <span class="font-mono text-xs font-medium text-accent uppercase tracking-wider">Termal Yazdırmanın Otoritesi</span>
          <h1 class="font-display text-3xl md:text-4xl font-bold text-ink tracking-tight mt-1">Termal Yazıcı Rehber Kütüphanesi</h1>
          <p class="text-ink/60 mt-2 text-base md:text-lg">
            Geliştiriciler, restoranlar ve depolar için {guides.length} teknik rehber ve 2.500 model spesifik dokümantasyon.
          </p>
        </div>
        <div class="font-mono text-xs text-ink/50 bg-white border border-gray-200 px-4 py-2 rounded-md shrink-0 self-start md:self-auto">
          Toplam {guides.length} uzman rehber + 2.500 model kılavuzu
        </div>
      </div>

      <!-- Kompakt Android uygulaması notu — ikincil bir ürün, sayfanın öncüsü değil -->
      <a
        href="https://play.google.com/store/apps/details?id=com.mobileprint.service"
        target="_blank"
        rel="noopener"
        class="mt-6 inline-flex items-center gap-2 bg-white border border-gray-200 hover:border-accent/40 text-sm text-ink/60 hover:text-accent px-4 py-2 rounded-md transition"
      >
        <span>Ayrıca mevcut: doğrudan termal yazdırma için Printzen Android uygulaması</span>
        <span aria-hidden="true">→</span>
      </a>

      <!-- Quick Category Tabs (Filter Bar) -->
      <div class="mt-8 flex flex-wrap gap-2 pt-4 border-t border-gray-200" id="filter-tabs">
        <button class="filter-tab active bg-ink text-paper text-xs font-semibold px-4 py-2 rounded-md transition" data-filter="all">Tümü ({guides.length})</button>
        <button class="filter-tab bg-white hover:bg-gray-100 text-ink/70 border border-gray-300 text-xs font-semibold px-4 py-2 rounded-md transition" data-filter="esc-pos">ESC/POS & Fiş</button>
        <button class="filter-tab bg-white hover:bg-gray-100 text-ink/70 border border-gray-300 text-xs font-semibold px-4 py-2 rounded-md transition" data-filter="zpl">Zebra & ZPL</button>
        <button class="filter-tab bg-white hover:bg-gray-100 text-ink/70 border border-gray-300 text-xs font-semibold px-4 py-2 rounded-md transition" data-filter="bluetooth">Bluetooth & BLE</button>
        <button class="filter-tab bg-white hover:bg-gray-100 text-ink/70 border border-gray-300 text-xs font-semibold px-4 py-2 rounded-md transition" data-filter="usb">WebUSB & Kablo</button>
        <button class="filter-tab bg-white hover:bg-gray-100 text-ink/70 border border-gray-300 text-xs font-semibold px-4 py-2 rounded-md transition" data-filter="sessiz">Sessiz Baskı</button>
        <button class="filter-tab bg-white hover:bg-gray-100 text-ink/70 border border-gray-300 text-xs font-semibold px-4 py-2 rounded-md transition" data-filter="e-ticaret">E-Ticaret & Kargo</button>
        <button class="filter-tab bg-white hover:bg-gray-100 text-ink/70 border border-gray-300 text-xs font-semibold px-4 py-2 rounded-md transition" data-filter="sorun">Sorun Giderme</button>
      </div>

      <!-- Inline Live Search Input -->
      <div class="mt-4 relative">
        <input
          type="text"
          id="inline-search-input"
          placeholder="Rehber başlığı, protokol veya anahtar kelime yazarak anında filtreleyin..."
          class="w-full bg-white border border-gray-300 rounded-md px-4 py-3 pl-11 text-sm text-ink placeholder-ink/40 outline-none focus:border-accent focus:ring-2 focus:ring-accent/10 transition"
        />
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-ink/40 absolute left-3.5 top-3.5 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </div>
    </div>
  </header>

  <main class="max-w-6xl mx-auto px-4 py-12">
    <!-- Guides Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6" id="guides-grid">
      {guides.map((guide) => {
        const slugClean = guide.slug.replace(/^tr\//, '');
        const textContent = `${guide.data.title} ${guide.data.description} ${guide.data.brand || ''} ${slugClean}`.toLowerCase();
        return (
          <a
            href={`/tr/rehberler/${slugClean}/`}
            class="guide-card block bg-white rounded-md p-6 border border-gray-200 hover:border-accent/50 transition flex flex-col justify-between group"
            data-search-text={textContent}
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="font-mono text-[11px] font-medium uppercase tracking-wider text-accent">
                  {classLabels[guide.data.printerClass]}{guide.data.brand ? ` · ${guide.data.brand}` : ''}
                </span>
                <span class="text-xs text-ink/40 group-hover:text-accent transition">Oku →</span>
              </div>
              <h2 class="text-base font-bold text-ink mb-2 group-hover:text-accent transition leading-snug">
                {guide.data.title}
              </h2>
              <p class="text-ink/60 text-xs line-clamp-3 leading-relaxed">
                {guide.data.description}
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-gray-100 flex items-center justify-between text-[11px] font-mono text-ink/40">
              <span>{guide.data.translationKey.includes('hub') ? 'Amiral Hub' : 'Teknik Kılavuz'}</span>
              <span>Printzen Docs</span>
            </div>
          </a>
        );
      })}
    </div>

    <!-- Empty State -->
    <div id="no-filter-results" class="hidden text-center py-16">
      <p class="text-ink/70 font-semibold">Aradığınız kriterlere uygun rehber bulunamadı.</p>
      <p class="text-xs text-ink/40 mt-1">Farklı bir arama terimi deneyebilir veya kategoriyi "Tümü" olarak seçebilirsiniz.</p>
    </div>

    <!-- Device Specific Directory Showcase (pSEO Bridge) -->
    <section class="mt-20 pt-12 border-t border-gray-200">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
        <div>
          <span class="font-mono text-xs font-medium text-accent uppercase tracking-wider">Donanım Uyumluluğu</span>
          <h2 class="font-display text-2xl font-bold text-ink mt-1">Desteklenen Termal Yazıcı Modelleri</h2>
          <p class="text-ink/60 text-sm mt-1">Sektörde en çok tercih edilen popüler modeller ve protokol uyumlulukları.</p>
        </div>
        <a href="/tr/yazicilar/" class="text-sm font-semibold text-accent hover:underline">
          Android Uygulamasıyla Test Edilen Yazıcıları Gör →
        </a>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {HARDWARE_SHOWCASE.map((brandGroup) => (
          <div class="bg-white rounded-md p-5 border border-gray-200">
            <h3 class="font-display font-semibold text-ink text-base mb-3 flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
              {brandGroup.brand}
            </h3>
            <ul class="space-y-1.5 text-xs">
              {brandGroup.models.map((model) => {
                const modelSlug = `${brandGroup.brand.toLowerCase()}-${model.toLowerCase()}`.replace(/\s+/g, '-');
                return (
                  <li>
                    <a
                      href="/tr/yazicilar/"
                      class="text-ink/60 hover:text-accent hover:underline transition flex items-center justify-between py-1"
                    >
                      <span>{brandGroup.brand} {model}</span>
                      <span class="text-ink/20">›</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>
    </section>
  </main>

  <Footer lang="tr" />
</BaseLayout>

<script is:inline>
  const filterTabs = document.querySelectorAll('.filter-tab');
  const searchInput = document.getElementById('inline-search-input');
  const cards = document.querySelectorAll('.guide-card');
  const noResults = document.getElementById('no-filter-results');

  let activeFilter = 'all';
  let searchQuery = '';

  function applyFilters() {
    let visibleCount = 0;

    cards.forEach((card) => {
      const text = card.getAttribute('data-search-text') || '';
      const matchesSearch = !searchQuery || text.includes(searchQuery);

      let matchesCategory = true;
      if (activeFilter === 'esc-pos') matchesCategory = text.includes('esc-pos') || text.includes('fiş');
      else if (activeFilter === 'zpl') matchesCategory = text.includes('zpl') || text.includes('zebra') || text.includes('etiket');
      else if (activeFilter === 'bluetooth') matchesCategory = text.includes('bluetooth') || text.includes('ble');
      else if (activeFilter === 'usb') matchesCategory = text.includes('usb') || text.includes('kablo');
      else if (activeFilter === 'sessiz') matchesCategory = text.includes('sessiz') || text.includes('kiosk');
      else if (activeFilter === 'e-ticaret') matchesCategory = text.includes('woocommerce') || text.includes('kargo') || text.includes('pazaryeri') || text.includes('trendyol') || text.includes('shopify');
      else if (activeFilter === 'sorun') matchesCategory = text.includes('sorun') || text.includes('hata') || text.includes('kalibrasyon') || text.includes('kararma') || text.includes('sıkışma');

      if (matchesSearch && matchesCategory) {
        card.classList.remove('hidden');
        visibleCount++;
      } else {
        card.classList.add('hidden');
      }
    });

    if (visibleCount === 0) {
      noResults?.classList.remove('hidden');
    } else {
      noResults?.classList.add('hidden');
    }
  }

  filterTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      filterTabs.forEach((t) => {
        t.classList.remove('active', 'bg-ink', 'text-paper');
        t.classList.add('bg-white', 'text-ink/70');
      });
      tab.classList.add('active', 'bg-ink', 'text-paper');
      tab.classList.remove('bg-white', 'text-ink/70');
      activeFilter = tab.getAttribute('data-filter') || 'all';
      applyFilters();
    });
  });

  searchInput?.addEventListener('input', (e) => {
    searchQuery = e.target.value.trim().toLowerCase();
    applyFilters();
  });
</script>
