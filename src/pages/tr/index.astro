---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const allGuides = await getCollection('guides', (entry) => entry.slug.startsWith('tr/'));
const recentGuides = [...allGuides]
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);
const printers = await getCollection('printers');

const PILLARS = [
  {
    tag: '01',
    title: 'Geliştirici Kılavuzları',
    description: 'Web ve mobil uygulamaları doğrudan termal yazıcılara bağlamak için Web Bluetooth, WebUSB, ham TCP soket ve REST API yöntemleri — çalışan kod örnekleriyle.',
    href: '/tr/rehberler/',
  },
  {
    tag: '02',
    title: 'Donanım & Protokol Karar Desteği',
    description: 'ESC/POS, ZPL, TSPL ve CPCL komut dili referansları, kod sayfası tabloları; mobil, masaüstü veya endüstriyel donanım seçimi için sınıf bazlı rehberlik.',
    href: '/tr/rehberler/',
  },
  {
    tag: '03',
    title: 'Sorun Giderme & Operasyon',
    description: 'Bluetooth eşleşme hataları, silik baskı, etiket kalibrasyonu, kargo etiketi boyutlandırma ve sessiz/kiosk yazdırma sorunlarına çözümler.',
    href: '/tr/rehberler/',
  },
];
---
<BaseLayout
  lang="tr"
  title="Printzen — Termal Yazdırmanın Otoritesi"
  description="Termal fiş ve etiket yazdırmanın tanımlayıcı referansı: ESC/POS, ZPL, TSPL ve daha fazlası için protokol belgeleri, donanım karar rehberleri ve entegrasyon yazıları — ayrıca kendi desteklenen yazıcı listesine sahip bir Android yazdırma uygulaması."
  alternatePath="/"
>
  <Nav wide lang="tr" alternatePath="/" />

  <!-- Hero -->
  <section class="max-w-5xl mx-auto px-4 py-20">
    <div class="flex flex-col md:flex-row gap-12 items-start">
      <div class="flex-1 min-w-0">
        <div class="font-mono text-xs font-medium tracking-wider uppercase text-accent mb-6">
          Termal Yazdırmanın Otoritesi
        </div>
        <h1 class="font-display text-4xl md:text-5xl font-bold text-ink mb-6 leading-tight tracking-tight">
          Termal fiş ve etiket yazdırmanın<br>tanımlayıcı referansı
        </h1>
        <p class="text-lg text-ink/60 mb-10 max-w-xl">
          ESC/POS, ZPL, TSPL ve CPCL için protokol referansları, donanım karar rehberleri ve entegrasyon yazıları — geliştiriciler, e-ticaret satıcıları, restoran işletmecileri ve termal yazıcılara bağlanan SaaS sağlayıcıları için.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/tr/rehberler/"
             class="bg-ink text-paper px-7 py-3.5 rounded-md text-base font-semibold hover:bg-accent-dark transition inline-flex items-center gap-2">
            Rehberlere Göz At →
          </a>
          <a href="/tr/yazicilar/" class="bg-transparent text-ink border border-gray-300 px-7 py-3.5 rounded-md text-base font-semibold hover:border-accent hover:text-accent transition inline-block">
            Desteklenen Yazıcıları Kontrol Et
          </a>
        </div>
        <p class="font-mono text-xs text-ink/40 mt-5">
          {allGuides.length}+ teknik rehber · Android uygulamasıyla test edilmiş {printers.length} yazıcı modeli
        </p>
      </div>

      <div class="w-full md:w-[320px] shrink-0 bg-terminal rounded-md overflow-hidden shadow-xl shadow-ink/10">
        <div class="flex items-center gap-1.5 px-3.5 py-2.5 bg-terminal-head border-b border-terminal-border">
          <div class="w-2 h-2 rounded-full bg-terminal-mid"></div>
          <div class="w-2 h-2 rounded-full bg-terminal-mid"></div>
          <div class="w-2 h-2 rounded-full bg-terminal-mid"></div>
          <span class="ml-1.5 font-mono text-[11px] text-terminal-dim">escpos-print.log</span>
        </div>
        <div class="p-4.5 font-mono text-[12.5px] leading-[1.8]">
          <div class="text-terminal-mid">; kesim + kalın başlık</div>
          <div class="text-terminal-text"><span class="text-terminal-amber">GS</span> V 66 0</div>
          <div class="text-terminal-text"><span class="text-terminal-amber">ESC</span> ! 0x08</div>
          <div class="text-terminal-text">"SİPARİŞ #4821"</div>
          <div class="text-terminal-text"><span class="text-terminal-amber">ESC</span> ! 0x00</div>
          <div class="text-terminal-mid">--------------------------------</div>
          <div class="text-terminal-dim">2x Americano&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;85.00</div>
          <div class="text-terminal-dim">1x Cheesecake&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;120.00</div>
          <div class="text-terminal-mid">--------------------------------</div>
          <div class="text-terminal-text font-semibold">TOPLAM&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;205.00</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Son rehberler şeridi -->
  <section class="max-w-5xl mx-auto px-4 pb-12">
    <div class="flex items-center justify-between mb-4 border-t border-gray-200 pt-8">
      <span class="font-mono text-xs font-medium tracking-wider uppercase text-ink/40">Son rehberler</span>
      <a href="/tr/rehberler/" class="text-sm text-accent hover:underline shrink-0">Tümünü gör →</a>
    </div>
    <div class="grid md:grid-cols-3 gap-4">
      {recentGuides.map((guide) => (
        <a href={`/tr/rehberler/${guide.slug.replace(/^tr\//, '')}/`} class="border border-gray-200 rounded-md p-4 hover:border-accent/40 transition group">
          <p class="text-sm font-medium text-ink group-hover:text-accent transition leading-snug">{guide.data.title}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Üç Ayak -->
  <section class="max-w-5xl mx-auto px-4 py-12">
    <div class="mb-10">
      <span class="font-mono text-xs font-medium tracking-wider uppercase text-accent">Burada ne var</span>
      <h2 class="font-display text-2xl md:text-3xl font-bold text-ink mt-1">Üç sac ayağı, tek platform</h2>
    </div>
    <div class="grid md:grid-cols-3 gap-6">
      {PILLARS.map((pillar) => (
        <a href={pillar.href} class="bg-paper rounded-md p-6 border border-gray-200 hover:border-accent/50 transition block group">
          <div class="font-mono text-xs text-ink/30 mb-3">{pillar.tag}</div>
          <h3 class="font-display font-semibold text-lg mb-2 text-ink group-hover:text-accent transition">{pillar.title}</h3>
          <p class="text-ink/60 text-sm leading-relaxed">{pillar.description}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Android Uygulaması (teklif edilen ürünlerden biri, tüm kimlik değil) -->
  <section id="android-app" class="max-w-5xl mx-auto px-4 py-20 scroll-mt-20">
    <div class="bg-paper rounded-md border border-gray-200 p-8 md:p-12">
      <div class="grid md:grid-cols-5 gap-10 items-center">
        <div class="md:col-span-3">
          <div class="font-mono text-xs font-medium tracking-wider uppercase text-accent mb-4">
            Printzen'den ayrıca
          </div>
          <h2 class="font-display text-2xl md:text-3xl font-bold text-ink mb-4">Android için Mobile Print Service</h2>
          <p class="text-ink/60 mb-6 leading-relaxed">
            Herhangi bir Android uygulamasından sistem yazdırma dialogu üzerinden herhangi bir termal yazıcıya yazdırın — Bluetooth, Wi-Fi veya USB. Zebra, Honeywell, TSC, Seiko, Bixolon, Sewoo, Rongta ve tüm genel ESC/POS termal yazıcıları destekler.
          </p>
          <a href="https://play.google.com/store/apps/details?id=com.mobileprint.service" target="_blank" rel="noopener"
             class="bg-ink text-paper px-6 py-3 rounded-md text-sm font-semibold hover:bg-accent-dark transition inline-flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M3 20.5v-17c0-.83 1.01-1.3 1.66-.78l15 8.5a1 1 0 010 1.56l-15 8.5C4.01 21.8 3 21.33 3 20.5z"/></svg>
            Google Play'den İndir
          </a>
        </div>
        <div class="md:col-span-2 grid grid-cols-2 gap-4">
          <div class="border border-gray-200 rounded-md p-4">
            <p class="font-mono text-xs text-ink/40 uppercase mb-1">BT Planı</p>
            <p class="text-2xl font-display font-bold text-ink mb-1">$9.90</p>
            <p class="text-xs text-ink/40">tek seferlik · Bluetooth + USB</p>
          </div>
          <div class="border border-accent/30 bg-accent/5 rounded-md p-4">
            <p class="font-mono text-xs text-accent uppercase mb-1">Tam Plan</p>
            <p class="text-2xl font-display font-bold text-ink mb-1">$14.90</p>
            <p class="text-xs text-ink/50">tek seferlik · + Wi-Fi & HTTP API</p>
          </div>
        </div>
      </div>
      <p class="text-xs text-ink/40 mt-6 pt-6 border-t border-gray-200">
        Her iki plan da 30 günlük ücretsiz deneme ve ücretsiz güncellemeler içerir, abonelik yok.
      </p>
    </div>
  </section>

  <Footer lang="tr" />
</BaseLayout>
